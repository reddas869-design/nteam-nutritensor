NTEAM_MODE=live
NTEAM_MODEL_PATH=/absolute/path/to/your/qwen-model
NTEAM_MODEL_BACKEND=transformers
NTEAM_LOCAL_FILES_ONLY=true
NTEAM_QUANTIZATION=nf4
NTEAM_DTYPE=float16
NTEAM_ATTENTION=sdpa
NTEAM_CONTEXT_TOKENS=4096
NTEAM_MAX_NEW_TOKENS=384
NTEAM_GPU_MEMORY_GIB=9
NTEAM_THINKING=false
NTEAM_FAST_SCAN=true
NTEAM_USERS_PATH=data/users.json
NTEAM_QUEUE_CAPACITY=4
NTEAM_DATABASE_PATH=data/nutritensor.sqlite3
NTEAM_CATALOG_PATH=data/foods.json
NTEAM_SESSION_SECRET=replace-with-at-least-32-random-characters
NTEAM_ADMIN_PASSWORD=replace-with-a-strong-local-password
NTEAM_COOKIE_SECURE=false
NTEAM_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
NTEAM_ENVIRONMENT=development
NTEAM_FDC_API_KEY=
NTEAM_ENABLE_OCR=false
NTEAM_REMOTE_LLM_URL=http://127.0.0.1:8080/v1
NTEAM_REMOTE_LLM_MODEL=local-qwen
NTEAM_REMOTE_LLM_KEY=
